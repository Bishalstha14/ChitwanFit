# Copy this file to .env and fill in your real Gmail values.
# Step 1: Enable 2-Step Verification on your Google account.
# Step 2: Create an App Password at https://myaccount.google.com/apppasswords
# Step 3: Put that 16-character password below (not your normal password!).

CHITWANFIT_EMAIL=youraccount@gmail.com
CHITWANFIT_EMAIL_PASSWORD=your-16-character-app-password